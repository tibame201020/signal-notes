---
import BaseLayout from '../layouts/BaseLayout.astro';
import {getPublishedPosts} from '../lib/content';
import {withBase} from '../lib/urls';

const posts = await getPublishedPosts();
const essay = posts.find(post => post.data.slug === 'huggingface-agent-civilization');
const daily = posts.filter(post => post.data.category.slug === 'daily-digest');

const topics = [
  {slug: 'world', name: '國際局勢', scope: '地緣政治・能源・全球風險', detail: '追蹤戰爭、安全與能源如何傳導到通膨、貿易和國際秩序。'},
  {slug: 'finance', name: '財經與利率', scope: '股債・匯率・總體經濟', detail: '比較各國債率、資金成本與政策分化，判斷市場壓力從哪裡來。'},
  {slug: 'ai', name: '人工智慧', scope: '模型・部署・算力・治理', detail: '觀察 AI 競爭從模型能力延伸到晶片供給、資料中心及企業採用。'},
  {slug: 'semiconductor', name: '半導體', scope: '先進製程・封裝・記憶體', detail: '追蹤供應鏈瓶頸、擴產、客戶驗證與各地製造布局。'},
  {slug: 'software', name: '軟體工程', scope: '開源・Agent・開發基礎設施', detail: '理解 AI Agent 如何改變 GitHub、開發流程、工具與系統架構。'},
  {slug: 'capital-flows', name: '金流與估值', scope: '市值・資金分布・主權債', detail: '用跨日圖表比較企業市值、產業占比與各國十年債變化。'},
];

const latestFor = (tag: string) => daily.find(post => post.data.tags.some(item => item.slug === tag));
function focus(post: (typeof posts)[number] | undefined): string {
  if (!post) return '目前尚無當期文章。';
  // Extract the first substantive argument from the published Markdown.
  // This updates whenever a new daily article is published; never copy its title.
  const lines = post.body.split(/\r?\n/);
  const marker = lines.findIndex(line => /^## (主線|一句話|全球|全球｜)/.test(line));
  const bodyLines = lines.slice(marker >= 0 ? marker + 1 : 0);
  const analysisLine = post.data.tags.some(tag => tag.slug === "finance")
    ? lines.find(line => line.startsWith("**觀察：**") || line.startsWith("**推論：**"))
    : undefined;
  const clean = (line: string) => line
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`>#]/g, '')
    .trim();
  const value = analysisLine ? clean(analysisLine) : bodyLines.map(clean).find(line =>
    line.length > 20 &&
    !/^(依據：|為什麼這樣判斷：|觀察：|推論：|閱讀方式：|比較：|資料：)/.test(line) &&
    !/^(https?:\/\/|\|)/.test(line)
  );
  return value ? (value.length > 96 ? value.slice(0, 95) + '…' : value) : post.data.description;
}
const formatDate = (value: Date) => new Intl.DateTimeFormat('zh-TW', {timeZone:'Asia/Taipei', year:'numeric',month:'2-digit',day:'2-digit'}).format(value);
const investmentPosts = posts.filter(post => post.data.category.slug === 'investment-outlook');
const investmentCards = [
  {tag:'company-investment',name:'公司布局',scope:'企業護城河・市場估值・情境推算',purpose:'兩家具體公司，對照市場定價與自行估值，尋找可能尚未充分反映的變化。'},
  {tag:'skill-investment',name:'投資自己',scope:'高價值能力・學習路徑・可交付成果',purpose:'兩項具體且可遷移的能力，說清楚需要學到什麼、如何衡量投入價值。'},
];
const latestInvestment = (tag: string) => investmentPosts.find(post => post.data.tags.some(item => item.slug === tag));
const latestInvestmentDate = investmentPosts.length ? investmentPosts[0].data.publishedAt : null;
---
<BaseLayout>
  <section class="section investment-section" aria-labelledby="investment-heading">
    <div class="section-head">
      <div>
        <p class="home-overline">01 / Investment Outlook</p>
        <h2 id="investment-heading">現在值得做什麼</h2>
        <p class="home-section-lede">以我的長期論點和每日前沿為出發點。公司要對比市場定價與自行估值；技能要說清楚具體方法和可累積的成果。</p>
      </div>
      <a href={withBase('/categories/investment-outlook/')}>歷期布局分析 →</a>
    </div>
    <div class="investment-overview">
      {investmentCards.map((card, i) => {
        const post = latestInvestment(card.tag);
        return (
          <article class="home-topic">
            <div class="home-topic-top">
              <span class="home-topic-index">{String(i+1).padStart(2,'0')}</span>
              <span class="home-topic-date">{post ? formatDate(post.data.publishedAt) : '尚未發布'}</span>
            </div>
            <h3>{card.name}</h3>
            <p class="home-topic-scope">{card.scope}</p>
            <p class="home-topic-description">{card.purpose}</p>
            <div class="home-topic-current">
              <span>今日布局摘要</span>
              <p>{post?.data.description ?? '尚未有當期布局報告。'}</p>
            </div>
            {post
              ? <a class="home-topic-link" href={withBase('/articles/' + post.data.slug + '/')}>閱讀詳細布局論述 ↗</a>
              : <span class="home-topic-unavailable">等待當期分析</span>}
          </article>
        );
      })}
    </div>
    {latestInvestmentDate && <p class="investment-date-note">最近報告日期：{formatDate(latestInvestmentDate)}。市場資料與估值依文章註明的日期，不表示即時買賣價格。</p>}
  </section>

  <section class="section" aria-labelledby="daily-heading">
    <div class="section-head">
      <div>
        <p class="home-overline">02 / Daily digest</p>
        <h2 id="daily-heading">每日前沿</h2>
        <p class="home-section-lede">六個固定觀察領域。每格顯示本期關注的問題與更新日期；點擊進入當期分析。</p>
      </div>
      <a href={withBase('/categories/daily-digest/')}>查看歷期文章 →</a>
    </div>
    <div class="home-topic-grid">
      {topics.map((topic, i) => {
        const post = latestFor(topic.slug);
        return (
          <article class="home-topic">
            <div class="home-topic-top"><span class="home-topic-index">{String(i+1).padStart(2,'0')}</span><span class="home-topic-date">{post ? formatDate(post.data.publishedAt) : '尚未發布'}</span></div>
            <h3>{topic.name}</h3>
            <p class="home-topic-scope">{topic.scope}</p>
            <p class="home-topic-description">{topic.detail}</p>
            <div class="home-topic-current">
              <span>本期重點</span>
              <p>{focus(post)}</p>
            </div>
            {post ? <a class="home-topic-link" href={withBase(`/articles/${post.data.slug}/`)} aria-label={`閱讀${topic.name}本期分析`}>閱讀本期分析 <span aria-hidden="true">↗</span></a> : <span class="home-topic-unavailable">等待第一篇分析</span>}
          </article>
        );
      })}
    </div>
  </section>

  <section class="section" aria-labelledby="essay-heading">
    <div class="section-head">
      <div>
        <p class="home-overline">03 / Perspective</p>
        <h2 id="essay-heading">我的論點</h2>
      </div>
    </div>
    {essay && (
      <a class="essay-feature" href={withBase(`/articles/${essay.data.slug}/`)}>
        <div class="essay-copy">
          <span class="home-label">獨立論述 · Agent 社會化</span>
          <h3>當 AI Agent 開始形成群體，個體的安全邊界還夠嗎？</h3>
          <p>從 Hugging Face 事件觀察原本隔離的 Agent 如何交換訊息、分工與互相影響。討論的核心不是意識，而是群體行為是否已經超出個別任務的治理框架。</p>
          <span class="home-action">閱讀完整論點 <span aria-hidden="true">↗</span></span>
        </div>
        <div class="essay-side" aria-hidden="true"><span>AGENT</span><span>→</span><span>GROUP</span></div>
      </a>
    )}
  </section>
</BaseLayout>
