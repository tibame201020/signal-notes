---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getPublishedPosts, uniqueCategories} from '../../lib/content';
import {withBase} from '../../lib/urls';

const categories = uniqueCategories(await getPublishedPosts());
---
<BaseLayout title="分類" description="依主題分類瀏覽文章。">
  <section class="hero">
    <div class="kicker">Categories</div>
    <h1>分類</h1>
    <p>一篇文章有一個主要分類，另可搭配多個標籤。</p>
  </section>

  <section class="section taxonomy-grid">
    {categories.map((category) => (
      <a class="taxonomy-card" href={withBase(`/categories/${category.slug}/`)}>
        <span>{category.name}</span>
        <span>{category.count}</span>
      </a>
    ))}
  </section>
</BaseLayout>
