---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getPublishedPosts, uniqueTags} from '../../lib/content';
import {withBase} from '../../lib/urls';

const tags = uniqueTags(await getPublishedPosts());
---
<BaseLayout title="標籤" description="依標籤瀏覽文章。">
  <section class="hero">
    <div class="kicker">Tags</div>
    <h1>標籤</h1>
    <p>跨分類的主題索引。</p>
  </section>

  <section class="section">
    <div class="tag-row">
      {tags.map((tag) => (
        <a class="tag" href={withBase(`/tags/${tag.slug}/`)}>#{tag.name} · {tag.count}</a>
      ))}
    </div>
  </section>
</BaseLayout>
