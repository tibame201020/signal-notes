---
import '@fontsource-variable/geist';
import '@fontsource-variable/noto-sans-tc';
import '../styles/global.css';
import {siteConfig} from '../site.config';
import {withBase} from '../lib/urls';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = siteConfig.description,
  canonicalPath = '/',
  type = 'website',
} = Astro.props;

const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const canonical = Astro.site
  ? new URL(withBase(canonicalPath), Astro.site)
  : undefined;
---
<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={withBase('/rss.xml')} />
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={withBase('/')}>{siteConfig.title}</a>
        <nav aria-label="主要導覽">
          <a href={withBase('/articles/')}>文章</a>
          <a href={withBase('/categories/')}>分類</a>
          <a href={withBase('/tags/')}>標籤</a>
          <a href={withBase('/rss.xml')}>RSS</a>
        </nav>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>{siteConfig.title}</span>
        <span>Static publishing via GitHub Pages</span>
      </div>
    </footer>
  </body>
</html>
