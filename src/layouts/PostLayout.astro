---
import BaseLayout from './BaseLayout.astro';
import {withBase} from '../lib/urls';

interface Taxonomy {
  name: string;
  slug: string;
}

interface Props {
  title: string;
  description: string;
  slug: string;
  publishedAt: Date;
  updatedAt?: Date;
  category: Taxonomy;
  tags: Taxonomy[];
}

const {
  title,
  description,
  slug,
  publishedAt,
  updatedAt,
  category,
  tags,
} = Astro.props;

const date = new Intl.DateTimeFormat('zh-TW', {dateStyle: 'long'});
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/articles/${slug}/`}
  type="article"
>
  <article class="post">
    <header class="post-header">
      <div class="eyebrow">
        <a href={withBase(`/categories/${category.slug}/`)}>{category.name}</a>
      </div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="post-meta">
        <time datetime={publishedAt.toISOString()}>{date.format(publishedAt)}</time>
        {updatedAt && <span>更新 {date.format(updatedAt)}</span>}
      </div>
      {tags.length > 0 && (
        <div class="tag-row" aria-label="標籤">
          {tags.map((tag) => (
            <a class="tag" href={withBase(`/tags/${tag.slug}/`)}>#{tag.name}</a>
          ))}
        </div>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
